generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String   @id @default(cuid())
  login        String   @unique
  passHash     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  characters     Character[]
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  accountId  String
  tokenHash  String    @unique
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Character {
  id           String   @id @default(cuid())
  accountId    String
  name         String
  race         String
  classId      String
  sex          String

  level        Int      @default(1)
  exp          BigInt   @default(0)
  sp           Int      @default(0)

  adena        BigInt   @default(0)  // Int overflow > 2.1B
  aa           BigInt   @default(0)  // Ancient Adena
  coinLuck     BigInt   @default(0)
  coinsSilver  BigInt   @default(0)  // Серебряные Монеты

  // Один JSON під "героя" (статі, hp/mp/cp, бафи, позиція, що завгодно)
  heroJson     Json     @default("{}")

  // ✅ Додаємо окремо колір ніку, щоб не тягнути heroJson в пошті/чаті
  nickColor    String?

  // 🔥 Відстеження активності для онлайн
  lastActivityAt DateTime @default(now()) @updatedAt

  // Адмін: бан (не може писати в общ/торг/клан), блок (не може грати)
  bannedUntil  DateTime?
  blockedUntil DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inventory    InventoryItem[]
  chatMessages ChatMessage[]
  lettersFrom  Letter[] @relation("LettersFrom")
  lettersTo    Letter[] @relation("LettersTo")
  news         News[]   @relation("News")
  sevenSealsMedals SevenSealsMedal[]
  createdClan  Clan?    @relation("ClanCreator")
  clanMember   ClanMember?
  clanChatMessages ClanChat[]
  clanLogs     ClanLog[]
  forumTopics  ForumTopic[]
  forumPosts   ForumPost[]
  marketListingsSold   PlayerMarketListing[] @relation("MarketListingSeller")
  marketListingsBought PlayerMarketListing[] @relation("MarketListingBuyer")
  partyMember         PartyMember?
  partyInvitesFrom    PartyInvite[] @relation("PartyInviteFrom")
  partyInvitesTo      PartyInvite[] @relation("PartyInviteTo")

  @@index([accountId])
  @@index([lastActivityAt]) // Індекс для швидкого пошуку онлайн гравців
  @@unique([accountId, name])
}

model InventoryItem {
  id           String   @id @default(cuid())
  characterId  String

  itemId       String   // твій внутрішній id типу "weapon_demon_c"
  qty          Int      @default(1)
  equippedSlot String?  // "weapon" | "shield" | "head" ...
  meta         Json     @default("{}") // заточка, елементи, кастомні поля

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([characterId, itemId])
}

model Kv {
  key        String   @id
  value      String
  updatedAt  DateTime @updatedAt
}

model ChatMessage {
  id          String   @id @default(cuid())
  characterId String
  channel     String   @default("general") // "general", "trade", "clan", "private"
  message     String
  createdAt   DateTime @default(now())

  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([channel, createdAt])
  @@index([characterId])
}

model Letter {
  id          String   @id @default(cuid())
  fromCharacterId String
  toCharacterId   String
  subject     String   @default("")
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  readAt      DateTime?

  fromCharacter Character @relation("LettersFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter   Character @relation("LettersTo", fields: [toCharacterId], references: [id], onDelete: Cascade)

  @@index([toCharacterId, isRead, createdAt])
  @@index([fromCharacterId])

  // ✅ Для переписки (OR: A->B або B->A) + orderBy createdAt
  @@index([fromCharacterId, toCharacterId, createdAt])
  @@index([toCharacterId, fromCharacterId, createdAt])
}

model News {
  id           String   @id @default(cuid())
  type         String   // "new_player" | "premium_purchase" | "raid_boss_kill"
  characterId  String?  // ID гравця (nullable для new_player)
  characterName String? // Нік гравця
  metadata     Json     @default("{}") // Додаткова інформація: { hours?: number, bossName?: string, bossLevel?: number, bossDrops?: any[] }
  createdAt    DateTime @default(now())

  character    Character? @relation("News", fields: [characterId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
}

model SevenSealsMedal {
  id          String   @id @default(cuid())
  characterId String
  weekStart   DateTime // Початок тижня (понеділок) для групування
  createdAt   DateTime @default(now())

  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, weekStart])
  @@index([weekStart])
}

model SevenSealsScore {
  id          String   @id @default(cuid())
  characterId String   @unique
  points      Int      @default(0)
  seal        String?  // "dawn" | "dusk" або null
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([points])
}

model Clan {
  id          String   @id @default(cuid())
  name        String   @unique // Назва клану (унікальна)
  level       Int      @default(1)
  reputation  Int      @default(0) // Репутація клану
  adena       BigInt   @default(0) // Адена клану
  coinLuck    BigInt   @default(0) // Coin of Luck клану
  emblem      String?  // Емблема клану (назва файлу)
  announcement String? @default("") // Оголошення від лідера
  creatorId   String   @unique // ID гравця, який створив клан (один гравець = один клан)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     Character @relation("ClanCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     ClanMember[]
  chatMessages ClanChat[]
  logs        ClanLog[]
  warehouse   ClanWarehouse[]
  invites     ClanInvite[]
  applications ClanApplication[]

  @@index([creatorId])
  @@index([name])
}

model ClanInvite {
  id          String   @id @default(cuid())
  clanId      String
  characterId String   // Запрошений гравець
  invitedBy   String   // Лідер або зам
  status      String   @default("pending") // pending | accepted | declined
  createdAt   DateTime @default(now())

  clan        Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, characterId]) // Один pending invite на пару
  @@index([characterId])
  @@index([clanId])
}

model ClanApplication {
  id          String   @id @default(cuid())
  clanId      String
  characterId String   // Гравець, що подав заявку
  status      String   @default("pending") // pending | accepted | declined
  createdAt   DateTime @default(now())

  clan        Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, characterId]) // Одна pending заявка на пару
  @@index([characterId])
  @@index([clanId])
}

model ClanMember {
  id          String   @id @default(cuid())
  clanId      String
  characterId String   @unique // Один гравець може бути тільки в одному клані
  title       String?  // Титул гравця (наприклад, "Топ")
  isDeputy    Boolean  @default(false) // Замісник глави
  joinedAt    DateTime @default(now())

  clan        Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([clanId])
  @@index([characterId])
}

model ClanChat {
  id          String   @id @default(cuid())
  clanId      String
  characterId String
  message     String
  createdAt   DateTime @default(now())

  clan        Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([clanId, createdAt])
  @@index([characterId])
}

model ClanLog {
  id          String   @id @default(cuid())
  clanId      String
  type        String   // "member_joined", "member_left", "member_kicked", "item_deposited", "item_withdrawn", "title_changed", "deputy_appointed", "deputy_removed"
  characterId String?  // ID гравця, який виконав дію (nullable для системних подій)
  targetCharacterId String? // ID цільового гравця (для kicked, title_changed, etc.)
  message     String   // Текст логу
  metadata    Json     @default("{}") // Додаткова інформація
  createdAt   DateTime @default(now())

  clan        Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([clanId, createdAt])
  @@index([characterId])
}

model ClanWarehouse {
  id          String   @id @default(cuid())
  clanId      String
  itemId      String   // ID предмета
  qty         Int      @default(1)
  meta        Json     @default("{}") // Метадані предмета
  depositedBy String?  // ID гравця, який поклав предмет
  depositedAt DateTime @default(now())

  clan        Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId])
  @@index([clanId, depositedAt])
}

model AdminMfa {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  login     String   @unique
  secretEnc String
  enabledAt DateTime?
}

model AdminRefreshToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  tokenHash String   @unique
  login     String

  @@index([login, expiresAt])
}

model ForumCategory {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  topics ForumTopic[]

  @@index([sortOrder])
}

model ForumTopic {
  id          String   @id @default(cuid())
  categoryId  String
  characterId String
  title       String
  postCount   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  posts     ForumPost[]

  @@index([categoryId, updatedAt])
  @@index([characterId])
}

model ForumPost {
  id          String   @id @default(cuid())
  topicId     String
  characterId String
  message     String
  createdAt   DateTime @default(now())

  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  character Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
  @@index([characterId])
}

/// Онлайн-ринок між гравцями: лот 24 год, після — предмет повертається продавцю
model PlayerMarketListing {
  id                String    @id @default(cuid())
  sellerCharacterId String
  sellerName        String
  itemSnapshot      Json
  currency          String // "adena" | "coinLuck"
  price             BigInt
  status            String    @default("active") // active | sold | expired | cancelled
  buyerCharacterId  String?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  soldAt            DateTime?

  seller Character  @relation("MarketListingSeller", fields: [sellerCharacterId], references: [id], onDelete: Cascade)
  buyer  Character? @relation("MarketListingBuyer", fields: [buyerCharacterId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([sellerCharacterId, status])
}

model AdminActionLog {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  adminLogin          String
  action              String
  targetCharacterId   String?
  targetCharacterName String?
  status              String
  message             String?
  before              Json?
  after               Json?
  metadata            Json     @default("{}")

  @@index([createdAt])
  @@index([adminLogin, createdAt])
  @@index([action, createdAt])
  @@index([targetCharacterId, createdAt])
  @@index([status, createdAt])
}

/// Події гравця для адмін-аналітики (синхрон героя, інвентар, ринок)
model PlayerActivityLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  accountId     String
  characterId   String
  characterName String
  action        String
  metadata      Json     @default("{}")
  clientIp      String?

  @@index([createdAt])
  @@index([characterId, createdAt])
  @@index([accountId, createdAt])
  @@index([action, createdAt])
}

/// Група до 5 персонажів; локація не перевіряється.
model Party {
  id                String   @id @default(cuid())
  leaderCharacterId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members PartyMember[]
  invites PartyInvite[]

  @@index([leaderCharacterId])
}

model PartyMember {
  id          String   @id @default(cuid())
  partyId     String
  characterId String   @unique
  joinedAt    DateTime @default(now())

  party     Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([partyId])
}

model PartyInvite {
  id              String   @id @default(cuid())
  partyId       String
  fromCharacterId String
  toCharacterId   String
  status        String   @default("pending") // pending | accepted | declined
  createdAt     DateTime @default(now())

  party       Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  fromCharacter Character @relation("PartyInviteFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter   Character @relation("PartyInviteTo", fields: [toCharacterId], references: [id], onDelete: Cascade)

  @@unique([partyId, toCharacterId])
  @@index([toCharacterId, status])
  @@index([partyId])
}

/// Дедуп email-сповіщень про сигнали (тип на персонажа), щоб не спамити одним і тим самим
model AdminSignalEmailSent {
  id           String   @id @default(cuid())
  characterId  String
  signalType   String
  lastSentAt   DateTime @default(now())

  @@unique([characterId, signalType])
}